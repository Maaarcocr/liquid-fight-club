{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8"
  },
  "permissions": {
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Workflow",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(./harness/**)",
      "Write(./harness/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/setup.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
